# ── Supabase ─────────────────────────────────────────────
# Leave both empty to run Spot OS in local demo mode (data in the browser).
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never put the service-role key in this app. Spot OS does not need it.

# ── Google (optional) ────────────────────────────────────
# Enables the "Drive" picker button in Library → Add.
# Google Cloud console → APIs & Services: enable Google Picker API + Drive API,
# create an OAuth client (Web) with your site URL as an authorised JS origin, and an API key.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
